  "extensionGuidelines": {
    "description": "How to add additional fields to output reports (OCP-compliant approach)",
    "philosophy": "Following the Open-Closed Principle, the system should be open for extension but closed for modification. New fields can be added without changing existing code structure.",

    "steps": [
      {
        "step": 1,
        "action": "Choose field from availableFields list above",
        "example": "Email address"
      },
      {
        "step": 2,
        "action": "Add property to Models/ApplicationRecord.cs",
        "code": "[Name(\"Email address\")]\npublic string? EmailAddress { get; set; }"
      },
      {
        "step": 3,
        "action": "Add property to Models/OutputRecord.cs",
        "code": "public string? EmailAddress { get; set; }"
      },
      {
        "step": 4,
        "action": "Update Services/CsvService.cs - LoadApplicationRecordsFromExcel() method (line ~183-195)",
        "code": "EmailAddress = GetValue(row, \"Email address\")"
      },
      {
        "step": 5,
        "action": "Add to ColumnOrder list in Services/CsvService.cs (line ~18-25)",
        "code": "Insert \"EmailAddress\" at desired position in list"
      },
      {
        "step": 6,
        "action": "Update switch statement in GenerateOutputFiles() method (line ~241-260)",
        "code": "\"EmailAddress\" => record.EmailAddress ?? \"\","
      },
      {
        "step": 7,
        "action": "Update MainWindow.axaml.cs data enrichment logic (line ~244-261) if needed",
        "code": "EmailAddress = app.EmailAddress"
      },
      {
        "step": 8,
        "action": "(Optional) Add special formatting if needed",
        "options": [
          "Add to RightAlignedColumns set if right-aligned",
          "Add to DateColumns set if date formatting needed",
          "Add custom formatting logic in GenerateOutputFiles()"
        ]
      }
    ],

